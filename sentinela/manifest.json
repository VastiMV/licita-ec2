{
  "manifest_version": 3,
  "name": "Sentinela · Licita",
  "version": "0.2.0",
  "description": "Lê o Compras.gov.br na sua própria sessão e manda para o Licita. Nunca resolve captcha, nunca guarda senha, nunca escreve no Compras.gov.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://cnetmobile.estaleiro.serpro.gov.br/*",
    "https://insidelicitacoes.com.br/*",
    "https://www.insidelicitacoes.com.br/*",
    "https://16-59-20-70.sslip.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "fundo.js" },
  "content_scripts": [
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/*"],
      "js": ["pagina.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/*"],
      "js": ["ponte.js", "camada.js"],
      "css": ["camada.css"],
      "run_at": "document_start"
    }
  ],
  "options_page": "opcoes.html",
  "action": {
    "default_title": "Sentinela · Licita",
    "default_popup": "opcoes.html"
  }
}
