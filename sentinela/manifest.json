{
  "manifest_version": 3,
  "name": "Sentinela · Licita",
  "version": "0.2.6",
  "description": "Lê o Compras.gov na sua sessão para o Licita. Nunca resolve captcha nem guarda senha. Só escreve o que você pede (tirar favorito).",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://cnetmobile.estaleiro.serpro.gov.br/*",
    "https://insidelicitacoes.com.br/*",
    "https://www.insidelicitacoes.com.br/*",
    "https://16-59-20-70.sslip.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/*"],
      "js": ["pagina.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://cnetmobile.estaleiro.serpro.gov.br/*"],
      "js": ["ponte.js", "camada.js"],
      "css": ["camada.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://insidelicitacoes.com.br/*",
        "https://www.insidelicitacoes.com.br/*",
        "https://16-59-20-70.sslip.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["licita.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "options_page": "opcoes.html",
  "action": {
    "default_title": "Sentinela · Licita",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    },
    "default_popup": "opcoes.html"
  }
}
