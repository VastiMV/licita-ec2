# DOMINIO vem do .env (ex.: insidelicitacoes.com.br). O Caddy tira e renova
# o certificado HTTPS sozinho — só precisa do DNS apontando para o EC2.

{$DOMINIO} {
	encode gzip
	handle /.well-known/security.txt {
		root * /srv
		file_server
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	# Documentação (GEN-63): só com o passe do Licita. O backend responde 204
	# (entra) ou 302 para /abrir-documentacao (pede o passe; sem login, login).
	handle /documentacao* {
		forward_auth backend:8000 {
			uri /api/auth/documentacao/verificar/
		}
		reverse_proxy docs:80
	}
	handle {
		reverse_proxy frontend:80
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# O ambiente de teste (deploy/ec2/docker-compose.teste.yml). Desligado, os
# containers não existem e o Caddy cai no handle_errors com um aviso.
teste.{$DOMINIO} {
	encode gzip
	handle /api/* {
		reverse_proxy teste-backend:8000
	}
	handle {
		reverse_proxy teste-frontend:80
	}
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "Ambiente de teste desligado (ou ainda ligando). Ligue pelo botão \"Teste: ligar\" no GitHub e espere alguns minutos." 503
	}
}
